{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python tools/check.py)",
      "Bash(python tools/build-guide.py)",
      "Bash(python tools/build-outline-export.py)",
      "Bash(python tools/update-option-related.py)",
      "Bash(bash -n:*)"
    ],
    "deny": [
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(sftp:*)",
      "Bash(rsync:*)",
      "Bash(docker:*)",
      "Bash(git push:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./outline-export/**/*.md)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Read(./**/*_rsa)",
      "Read(./**/credentials*)",
      "Read(./secrets/)",
      "Read(./**/*.secret)",
      "Read(./**/*token*)",
      "Read(./**/*password*)",
      "Edit(./outline-export/**)",
      "Write(./outline-export/**)",
      "Read(./ai-server-setup-guide.md)",
      "Edit(./ai-server-setup-guide.md)",
      "Write(./ai-server-setup-guide.md)",
      "Read(./caddy-root-ca.crt)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python || command -v python3 || command -v py)\" \"$CLAUDE_PROJECT_DIR/tools/block-shell-reads.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python || command -v python3 || command -v py)\" \"$CLAUDE_PROJECT_DIR/tools/stop-check.py\"",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
