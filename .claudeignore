.git/
# Generated copy of the guide and options (rebuilt by tools/build-outline-export.py); PNGs stay visible for diagram checks
outline-export/*.md
outline-export/options/
__pycache__/
*.pyc
.venv/
# Generated by tools/build-guide.py from guide/*.md; agents read the parts
ai-server-setup-guide.md
# Agent Smith report: read only when asked
AGENT_SMITH_REPORT.md
# Server-specific CA exported by the guide (in .gitignore too); keep its server name out of the repo
caddy-root-ca.crt
.claude/settings.local.json
